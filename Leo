-- HELPER: Hex to RGB Conversion
local function hexToRGB(hex)
    return {
        r = tonumber(hex:sub(1, 2), 16) / 255,
        g = tonumber(hex:sub(3, 4), 16) / 255,
        b = tonumber(hex:sub(5, 6), 16) / 255,
    }
end

-- Dynamic Menu Creator from JSON
local function setupMenuFromConfig(config)
    for _, item in ipairs(config.objects or {}) do
        local control = {
            id = item.idx,
            type = item.type,
            value = item.value,
        }

        if item.type == "KeyPicker" then
            control.key = item.key or "None"
            control.mode = item.mode or "Toggle"
        elseif item.type == "ColorPicker" then
            control.color = hexToRGB(item.value)
        elseif item.type == "Dropdown" then
            control.options = item.value
        end

        table.insert(menu.controls, control)
    end
end
setupMenuFromConfig(configData)

-- RENDER MENU UI
local function drawMenu()
    if not menu.enabled then return end

    -- Render Menu Background
    drawBox(menu.position, { w = 400, h = 30 * #menu.controls + 50 }, menu.themeColor)

    -- Render Menu Controls
    local yOffset = 20
    for _, control in ipairs(menu.controls) do
        local display = ""
        if control.type == "Toggle" then
            display = control.value and "[ON]" or "[OFF]"
        elseif control.type == "Slider" then
            display = string.format("Value: %.2f", control.value)
        elseif control.type == "Dropdown" then
            display = table.concat(control.options, ", ")
        end
        drawText(
            string.format("%s: %s", control.id:gsub("_", " "), display),
            { x = menu.position.x + 10, y = menu.position.y + yOffset },
            { r = 1, g = 1, b = 1 }
        )
        yOffset = yOffset + 30
    end
end

-- FEATURE EXECUTION
local function executeFeature(control)
    if control.type == "Toggle" then
        features[control.id] = control.value
        print("Toggled feature:", control.id, "->", control.value)
    elseif control.type == "Slider" then
        features[control.id] = control.value
        print("Updated slider:", control.id, "->", control.value)
    elseif control.type == "Dropdown" then
        features[control.id] = control.options
        print("Updated dropdown:", control.id, "->", table.concat(control.options, ", "))
    end
end

-- UPDATE MENU STATE & DRAW
local function update()
    if isKeyPressed(menu.keybind) then
        menu.enabled = not menu.enabled
    end

    if menu.enabled then
        drawMenu()
    end

    for _, control in ipairs(menu.controls) do
        executeFeature(control)
    end
end

-- GAME LOOP
while true do
    update()
    wait(0.1)
end

